# Copy to .env and fill in. .env is gitignored and must never be committed.

# Site par: Scaleway API credentials, from https://console.scaleway.com/iam/api-keys
SCW_ACCESS_KEY=""
SCW_SECRET_KEY=""
SCW_DEFAULT_PROJECT_ID=""
SCW_DEFAULT_ORGANIZATION_ID=""

# The zone and region are NOT set here. They live in terraform/par and nowhere
# else. The Scaleway provider lets SCW_DEFAULT_ZONE in the environment override
# the zone in its own configuration, so setting it here would make the zone
# fallback a silent no-op. If your .env still has SCW_DEFAULT_ZONE or
# SCW_DEFAULT_REGION, delete those lines.

# Site fin: Verda API client credentials (OAuth client credentials), from the
# Verda console under Keys.
VERDA_CLIENT_ID=""
VERDA_CLIENT_SECRET=""

# The SSH keypair used for every node on both sites. Set the PRIVATE key only.
# The scripts derive the public key from it and hand that to Terraform, so there
# is no second path to keep in sync and no way to register one key and log in
# with another. To make a fresh one scoped to this project:
#
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_eu1 -C eu1
#
SSH_PRIVATE_KEY_PATH="$HOME/.ssh/id_ed25519"
