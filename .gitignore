# secrets
.env
*.pem
*.key
kubeconfig
kubeconfig-*

# terraform, one root per site under terraform/<site>/
# .terraform.lock.hcl is deliberately NOT ignored. A repository about pinning
# versions that lets its provider float would be arguing with itself. Commit it
# after the first terraform init.
terraform/*/.terraform/
terraform/*/*.tfstate
terraform/*/*.tfstate.*
terraform/*/*.tfvars
!terraform/*/terraform.tfvars.example
terraform/*/*.tfplan
terraform/*/crash.log

# session state, written by the up and down scripts of each site
.sessions.csv
.ssh-known-hosts-*

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# mkdocs
site/
.cache/

# macos
.DS_Store
